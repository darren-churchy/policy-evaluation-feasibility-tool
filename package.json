{
  "name": "policy-evaluation-feasibility-tool",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "spec:check": "node scripts/validate-spec.mjs",
    "check": "npm run spec:check && npm run spec:build:check && npm run pack:check && npm test && npm run build",
    "pack": "node scripts/build-reviewer-pack.mjs && node scripts/build-review-form.mjs",
    "pack:check": "node scripts/build-reviewer-pack.mjs --check",
    "spec:build": "node scripts/build-spec.mjs",
    "spec:build:check": "node scripts/build-spec.mjs --check",
    "css:vendor": "sass --load-path=. --no-source-map --style=compressed --quiet scripts/vendor-css.scss src/styles/vendor/govuk-moj.css"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@ministryofjustice/frontend": "^2.1.2",
    "govuk-frontend": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "sass": "^1.80.6",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
