{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stages.schema.json",
  "title": "Stage vocabulary, readiness gates and tool routing",
  "description": "One stage rule for the whole app. The engine owns inference; the Causal Readiness page, Design Finder and both trees call it. Resolves the current contradiction where the quant tree tags designs Grow-only while other tools say Test and Grow.",
  "type": "object",
  "required": ["spec_version", "stages", "readiness", "inference"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "stages": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "gloss"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "gloss": {
            "description": "One line shown on first use, so the label does not require prior knowledge of the Magenta Book.",
            "type": "string",
            "minLength": 1
          },
          "citations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "readiness": {
      "description": "The hard gates. Intervention specification and theory of change block; maturity warns and redirects.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "severity"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "question": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["gate", "warning"] },
          "redirect": { "type": "string" }
        }
      }
    },
    "inference": {
      "description": "Ordered rules; first match wins.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["when", "stages"],
        "additionalProperties": false,
        "properties": {
          "when": { "type": "object", "minProperties": 1 },
          "stages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "routing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "when": { "type": "object" }
        }
      }
    }
  }
}
