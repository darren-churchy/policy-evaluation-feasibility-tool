{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "guides.schema.json",
 "title": "Guides",
 "description": "Structured prompts producing notes rather than answers. Nothing declared here reaches the engine.",
 "type": "object",
 "required": [
  "spec_version",
  "guides"
 ],
 "additionalProperties": false,
 "properties": {
  "spec_version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "guides": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "purpose"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "title": {
      "type": "string",
      "minLength": 1
     },
     "purpose": {
      "type": "string",
      "minLength": 1
     },
     "when": {
      "type": "string",
      "minLength": 1
     },
     "fields": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "id",
        "label"
       ],
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
         "type": "string",
         "minLength": 1
        },
        "hint": {
         "type": "string"
        },
        "placeholder": {
         "type": "string"
        },
        "rows": {
         "type": "integer",
         "minimum": 2,
         "maximum": 12
        }
       }
      }
     },
     "table": {
      "type": "object",
      "required": [
       "id",
       "columns"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
       },
       "add_label": {
        "type": "string"
       },
       "columns": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "required": [
          "id",
          "label"
         ],
         "additionalProperties": false,
         "properties": {
          "id": {
           "type": "string",
           "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
           "type": "string",
           "minLength": 1
          },
          "hint": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
